<% # container for all documents in index list view -%>

<div class="exhibit-<%= document_index_view_type %>">
  <%= render ExhibitCardComponent.with_collection(documents.sort_by { |x| exhibit_metadata.dig(x.slug, 'title') if params[:sort] != 'count' }, response: @response, search_state: search_state, view_type: document_index_view_type) %>
</div>
