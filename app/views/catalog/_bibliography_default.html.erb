<% unless @document.reference? %>
  <div class='col-md-12 record-metadata-section'
       data-controller='bibliography'
       data-bibliography-path-value="<%= search_exhibit_catalog_path(exhibit_id: @exhibit) %>"
       data-bibliography-parent-id-value="<%= @document.id %>"
       data-bibliography-sort-value="author_sort asc, pub_year_isi asc, title_sort asc"
       style='display: none;'>
       <%# TODO: retrieve this sort configuration from the blacklight config %>
       <h3 class="col-md-9 mt-4">Bibliography</h3>
       <div class="col-md-9 bibliography-list" data-bibliography-target="list"></div>
  </div>
<% end %>
